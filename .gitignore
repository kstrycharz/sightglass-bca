# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
htmlcov/
.coverage
coverage.xml

# Node / Next.js
node_modules/
web/.next/
web/out/
web/.turbo/
*.tsbuildinfo

# Local env & secrets — never commit
.env
.env.*
!.env.example
*.pem
*.p12
*.pfx
*.key

# The dashboard's persisted API token, when the web app is run outside its
# container (in compose this lives in the `web-data` volume, not the repo).
web/data/

# Build & runtime output
dist/
build/
/var/
airgap-bundle/
*.tar.gz

# Synthetic test corpus is BUILT, never committed (sources live in tests/corpus/src)
tests/corpus/build/
tests/corpus/out/

# The release policy and its waivers are COMMITTED on purpose: the team that
# owns the artifact owns the definition of "shippable", and the file's git
# history is the audit trail for who weakened the gate and when (ADR-0019).
# Only local scratch under .sightglass/ is ignored.
.sightglass/cache/
.sightglass/*.local.yaml

# Scan output. These are per-run reports about a specific binary — they name
# internal paths, hostnames, and masked credentials, so they are the last thing
# that should land in a public repo by accident. Committing a baseline is a
# deliberate act; name it explicitly rather than letting the glob catch it.
*.sarif
*.cdx.json
sightglass-report-*.pdf
sightglass-report-*.html

# Design-tool exports and agent briefs. Working material for building the UI,
# not source: `design/` is a 2.3 MB published Claude Design canvas (bundled
# editor plus content) that nothing imports, and the redesign brief is written
# to be pasted into an agent rather than read by a contributor. Both are kept
# locally; neither belongs in a clone.
design/
docs/UI_REDESIGN_BRIEF.md

# Editors
.vscode/
.idea/
*.swp

# Claude Code local settings (machine-specific; CLAUDE.md itself is committed)
.claude/settings.local.json

# Tool droppings
.DS_Store
Thumbs.db
*.log
