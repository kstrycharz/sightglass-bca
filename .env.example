# Copy to .env and adjust. Every default here is the restrictive one.
# `.env` is gitignored; never commit real credentials to this repo.

# --- sandbox ----------------------------------------------------------------
# One directory, two paths. The worker spawns analyzer containers as siblings
# through the Docker socket, and the daemon resolves their bind mounts on the
# HOST — so the worker must tell it the host path, not its own.
#
#   _HOST : where the run root lives on the host (absolute; what the daemon sees)
#   (plain): where the worker sees it, fixed inside the image by compose
#
# On Windows use a Windows path here, e.g. C:\sightglass\runs — the driver
# translates. Getting this wrong yields analyzers with empty input directories
# and no error at all.
SIGHTGLASS_RUN_ROOT_HOST=/var/lib/sightglass/runs

# Only set this when running the orchestrator directly on the host rather than
# in compose; then it should equal SIGHTGLASS_RUN_ROOT_HOST.
# SIGHTGLASS_RUN_ROOT=/var/lib/sightglass/runs

SIGHTGLASS_SANDBOX_DRIVER=docker
SIGHTGLASS_REAPER_MAX_AGE_HOURS=6
SIGHTGLASS_REAPER_INTERVAL_SECONDS=300

# --- trust boundary ---------------------------------------------------------
# deny = no component may make outbound network calls. Loosen only when a cloud
# LLM provider is deliberately configured (M3).
SIGHTGLASS_EGRESS_POLICY=deny
SIGHTGLASS_AIR_GAPPED=false
# Dynamic analysis executes the artifact. Opt-in, per run, and never by default.
SIGHTGLASS_DYNAMIC_ANALYSIS_ENABLED=false
# Discovered secrets are stored hashed and masked unless this is enabled.
SIGHTGLASS_RETAIN_PLAINTEXT_SECRETS=false

# Whether uploads must carry an authorization attestation. Off for rapid
# prototyping so there is no upload friction; the schema, audit records, and
# report stamping all remain, so turning it on restores the gate with nothing
# to rebuild. Turn it on before anyone analyses an artifact they did not build.
SIGHTGLASS_REQUIRE_ATTESTATION=false

# --- local ports ------------------------------------------------------------
SIGHTGLASS_API_PORT=8000
SIGHTGLASS_WEB_PORT=3000
SIGHTGLASS_POSTGRES_PORT=5432
SIGHTGLASS_REDIS_PORT=6379
SIGHTGLASS_MINIO_PORT=9000
SIGHTGLASS_MINIO_CONSOLE_PORT=9001

# --- development credentials (compose only; change for any real deployment) --
MINIO_ROOT_USER=sightglass
MINIO_ROOT_PASSWORD=sightglass

SIGHTGLASS_LOG_LEVEL=INFO
